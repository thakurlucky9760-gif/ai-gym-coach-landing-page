# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.html text diff=html
*.css text diff=css
*.js text diff=javascript
*.json text
*.md text
*.svg text
*.yml text
*.yaml text

# Explicit binary files (prevent accidental CRLF transformation or corruption)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp4 binary
*.webm binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
